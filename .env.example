NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only, no NEXT_PUBLIC_ prefix. Get this from Supabase
# Dashboard → Project Settings → API → "Secret keys" section
# (looks like sb_secret_...). Never share this or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
